{
  "name": "vq-digitalwallet-reactnative-google",
  "version": "0.1.0",
  "private": true,
  "description": "VQ React Native Android SDK for Google Pay payments.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java",
    "android/build.gradle",
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-package.cjs",
    "clean": "del-cli android/build lib coverage *.tgz",
    "lint": "eslint src test/unit",
    "check:types": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:characterization": "node test/characterization/google-pay-token-encoding.test.mjs",
    "check:source": "node scripts/check-source.cjs",
    "check:package": "node scripts/check-package.cjs",
    "check:consumer-types": "tsc -p test/consumer/tsconfig.json",
    "check:generated": "node scripts/check-generated.cjs",
    "check:native-source": "node scripts/check-android-foundation.cjs",
    "check:audit": "node scripts/check-audit.cjs",
    "verify": "npm run check:source && npm run check:native-source && npm run lint && npm run check:types && npm run test:characterization && npm run test:coverage && npm run build && npm run check:consumer-types && npm run check:generated && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veritas-Quaesitor/vq-digitalwallet-reactnative-google.git"
  },
  "bugs": {
    "url": "https://github.com/Veritas-Quaesitor/vq-digitalwallet-reactnative-google/issues"
  },
  "homepage": "https://github.com/Veritas-Quaesitor/vq-digitalwallet-reactnative-google#readme",
  "keywords": [
    "react-native",
    "android",
    "google-pay",
    "digital-wallet",
    "payments"
  ],
  "author": "Veritas Quaesitor",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.3.0",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.85.0 || ^0.86.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "del-cli": "7.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ft-flow": "3.0.11",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "prettier": "3.8.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "0.43.0",
    "react-native-monorepo-config": "0.4.0",
    "typescript": "6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "VqGooglePaySpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.veritasquaesitor.vqgooglepay"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  }
}
